;; The site islands' dev builds. Smia-dev only: a site build compiles
;; each island bundle on demand (smia.site.islands, inline config), so
;; nothing compiled is committed and no Node is involved anywhere. This
;; file only serves interactive island development on the JVM, e.g.:
;;   clojure -M:cljs -m shadow.cljs.devtools.cli watch theme
{:deps   {:aliases [:cljs]}
 :builds {:search  {:target     :browser
                    :output-dir "build/cljs"
                    :asset-path "."
                    :modules    {:search {:init-fn smia.site.search-client/init}}}
          :mermaid {:target     :browser
                    :output-dir "build/cljs"
                    :asset-path "."
                    :modules    {:mermaid {:init-fn smia.site.mermaid-client/init}}}
          :theme   {:target     :browser
                    :output-dir "build/cljs"
                    :asset-path "."
                    :modules    {:theme {:init-fn smia.site.theme-client/init}}}
          :reader  {:target     :browser
                    :output-dir "build/cljs"
                    :asset-path "."
                    :modules    {:reader {:init-fn smia.site.reader-client/init}}}
          :keys    {:target     :browser
                    :output-dir "build/cljs"
                    :asset-path "."
                    :modules    {:keys {:init-fn smia.site.keys-client/init}}}}}
