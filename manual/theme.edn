{:color   {:text "#1c1c1c"
           :link "#2a52be"
           :muted "#666666"
           :rule "#bbbbbb"
           :code-background "#f4f4f4"}
 ;; The families lead with the embedded print fonts (see :book/print-x in
 ;; book.edn) and fall back to the generic faces. PDF/X requires every
 ;; glyph to come from an embedded font, so the leading family must match
 ;; a registered name; the same list is valid CSS for the HTML editions.
 :type    {:body-family    "Crimson Text, serif"
           :heading-family "Crimson Text, serif"
           :mono-family    "Space Mono, monospace"
           :base-size      "11pt"
           :line-height    "1.45"
           :h1-size        "22pt"
           :h2-size        "16pt"
           :h3-size        "13pt"
           :code-size      "8pt"
           :highlight      true}
 :code    {:keyword "#0033cc"
           :string  "#008800"
           :comment "#888888"
           :number  "#aa5500"
           :literal "#7700aa"}
 ;; No :paragraph token: the PDF editions set book paragraphs — a
 ;; first-line indent with no gap, the run opener flush.
 :spacing {:block "8pt"}
 ;; The online manual dogfoods the sidebar site layout (a sticky table of
 ;; contents beside the reading column), the opt-in search island, dark
 ;; mode, and the reader-preferences controls (width, text size, contrast,
 ;; and the color-scheme toggle the cluster folds in). Switch to :plain for
 ;; the minimal one-column style; drop :search, :reader, or :keyboard for
 ;; less JavaScript. The same manuscript builds either way.
 :site    {:layout   :sidebar
           :search   true
           :dark     true
           :reader   true
           :keyboard true}
 ;; No explicit margins: the page geometry falls back to the classical
 ;; canon, derived from the trim (inner:top:outer:bottom = 2:3:4:6).
 :layout  {:page-size      :digest
           :header-extent  "12mm"
           :footer-extent  "12mm"}
 ;; PDF furniture set in faces the tokens do not reach. These point at a
 ;; registered family so PDF/X conformance covers every glyph.
 :fo      {:file-bar        {:font-family "Space Mono, monospace"}
           :annotation-mark {:font-family "Space Mono, monospace"}}}
