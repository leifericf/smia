{:color   {:text "#1c1c1c"
           :link "#2a52be"
           :muted "#666666"
           :rule "#bbbbbb"
           :code-background "#f4f4f4"}
 ;; The families lead with the embedded print fonts (see :book/print-x in
 ;; book.edn) and fall back to the generic faces. PDF/X requires every
 ;; glyph to come from an embedded font, so the leading family must match
 ;; a registered name; the same list is valid CSS for the HTML editions.
 :type    {:body-family    "Crimson Text, serif"
           :heading-family "Crimson Text, serif"
           :mono-family    "Space Mono, monospace"
           :base-size      "11pt"
           :line-height    "1.45"
           :h1-size        "22pt"
           :h2-size        "16pt"
           :h3-size        "13pt"
           :highlight      true}
 :code    {:keyword "#0033cc"
           :string  "#008800"
           :comment "#888888"
           :number  "#aa5500"
           :literal "#7700aa"}
 :spacing {:paragraph "6pt"
           :block     "8pt"}
 ;; The online manual dogfoods the sidebar site layout (a sticky table of
 ;; contents beside the reading column) and the opt-in search island.
 ;; Switch to :plain for the minimal one-column style; drop :search for a
 ;; zero-JavaScript site. The same manuscript builds either way.
 :site    {:layout :sidebar
           :search true}
 :layout  {:page-size      :digest
           :margin-top     "24mm"
           :margin-bottom  "24mm"
           :margin-inside  "26mm"
           :margin-outside "20mm"
           :header-extent  "12mm"
           :footer-extent  "12mm"}
 ;; PDF furniture set in faces the tokens do not reach. These point at a
 ;; registered family so PDF/X conformance covers every glyph.
 :fo      {:file-bar        {:font-family "Space Mono, monospace"}
           :annotation-mark {:font-family "Space Mono, monospace"}}}
