{:book/slug       "smia-manual"
 :book/title      "The Smia Manual"
 :book/author     "The Smia authors"
 :book/language   "en-US"
 :book/site-url   "https://smia.leifericf.com/manual"
 :book/references "references.edn"

 :book/attributes {:tool "Smia"}

 :book/front-matter [{:role :preface :file "front/preface.md"}]

 :book/parts
 [{:part/title    "Writing"
   :part/chapters ["chapters/01-quickstart.md"
                   "chapters/02-markdown.md"
                   "chapters/03-authoring.md"]}
  {:part/title    "Configuration and Theming"
   :part/chapters ["chapters/04-configuration.md"
                   "chapters/05-theming.md"
                   "chapters/06-commands.md"]}
  {:part/title    "Producing and Publishing"
   :part/chapters ["chapters/07-book-production.md"
                   "chapters/08-editions.md"
                   "chapters/09-distribution.md"
                   "chapters/10-design.md"]}]

 :book/appendices ["chapters/11-error-catalog.md"
                   "chapters/12-clojure-for-authors.md"
                   "chapters/13-code-authoring.clj"]

 :book/back-matter [{:role :glossary :file "back/glossary.clj"}
                    {:role :list-of-figures}
                    {:role :list-of-tables}
                    {:role :list-of-listings}
                    {:role :bibliography}
                    {:role :index}]

 :book/downloads
 {:base   "https://github.com/leifericf/smia/releases/latest/download"
  :assets [{:label   "Screen PDF"
            :file    "smia-manual-screen.pdf"
            :note    "Symmetric margins, for reading on screen."
            :default true}
           {:label "Print PDF"
            :file  "smia-manual-print.pdf"
            :note  "Mirrored margins and a binding gutter, for printing."}
           {:label "Print-ready (PDF/X)"
            :file  "smia-manual-print-x.pdf"
            :note  "PDF/X-4 with embedded fonts, for a press."}
           {:label "EPUB"
            :file  "smia-manual.epub"
            :note  "Reflowable, for e-readers."}]}

 :book/print-x
 {:output-intent {:icc "assets/icc/sRGB-v2.icc" :profile-name "sRGB"}
  :fonts [{:family      "Crimson Text"
           :normal      "assets/fonts/crimson-text/CrimsonText-Regular.ttf"
           :bold        "assets/fonts/crimson-text/CrimsonText-Bold.ttf"
           :italic      "assets/fonts/crimson-text/CrimsonText-Italic.ttf"
           :bold-italic "assets/fonts/crimson-text/CrimsonText-BoldItalic.ttf"}
          {:family      "Space Mono"
           :normal      "assets/fonts/space-mono/SpaceMono-Regular.ttf"
           :bold        "assets/fonts/space-mono/SpaceMono-Bold.ttf"
           :italic      "assets/fonts/space-mono/SpaceMono-Italic.ttf"
           :bold-italic "assets/fonts/space-mono/SpaceMono-BoldItalic.ttf"}]}}
